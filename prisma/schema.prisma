generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     Int                      @id @default(autoincrement())
  email                  String                  @db.VarChar(100) @unique
  senha                  String                  @db.VarChar(100)
  nome                   String                  @db.VarChar(255)
  data_criacao           DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  notificacoes_agendadas notificacoes_agendadas[]
  tarefas                Tarefa[]
  preferencias_notificacoes preferencias_notificacoes?
  colunas Coluna[]

  @@map("usuarios")
}

model Tarefa {
  id           Int         @id @default(autoincrement())
  titulo       String      @db.VarChar(255)
  descricao    String
  status       String      @db.VarChar(50) @default("TODO")
  prioridade   prioridades @default(BAIXA)
  data_criacao DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  data_limite  DateTime    @db.Timestamp(6)
  id_coluna    Int
  notificacoes_agendadas notificacoes_agendadas[]

  id_usuario   Int
  usuario      Usuario     @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  coluna       Coluna     @relation(fields: [id_coluna], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("tarefas")
}

model Coluna {
  id           Int       @id @default(autoincrement())
  titulo       String    @db.VarChar(255)
  posicao      Int       @default(0)
  data_criacao DateTime  @default(now())

  id_usuario   Int
  usuario      Usuario   @relation(fields: [id_usuario], references: [id])

  @@map("colunas")
  tarefas Tarefa[]
}


model notificacoes_agendadas {
  id               Int       @id @default(autoincrement())
  data_notificacao DateTime? @db.Timestamp(6)
  id_tarefa        Int
  id_usuario       Int
  enviado          Boolean  @default(false)
  usuario          Usuario @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tarefa           Tarefa @relation(fields: [id_tarefa], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notificacoes_agendadas")
}

model preferencias_notificacoes {
  id                   Int    @id @default(autoincrement())
  id_usuario           Int    @unique 
  minutos_antecedencia Int[]  @default([60])

  usuario              Usuario @relation(fields: [id_usuario], references: [id])

  @@map("preferencias_notificacoes")

}

enum prioridades {
  BAIXA
  MEDIA
  ALTA
}
